[input_devices]

pointing/emulate_touch_from_mouse=true

[milestone]

general/achievements_path="res://addons/milestone/demo/achievements/"
debug/print_errors=true
debug/print_output=true
general/save_as_json=false

[netfox]

general/clear_settings=false
extras/auto_tile_windows=true
autoconnect/enabled=false
time/tickrate=60

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
