; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MyNetFox"
config/description="Network addon with rollback"
config/version="1.0.0"
run/main_scene="uid://bfshwoko470di"
config/features=PackedStringArray("4.6")
run/max_fps=60
boot_splash/show_image=false
config/icon="uid://bc4xl1ietmogn"

[autoload]

PatchLoader="*uid://d2i17lqsek4n5"
Async="*res://shared/scripts/async.gd"
WindowTiler="*res://addons/netfox.extras/window-tiler.gd"
NetworkSimulator="*res://addons/netfox.extras/network-simulator.gd"
NetworkTime="*res://addons/netfox/network-time.gd"
NetworkTimeSynchronizer="*res://addons/netfox/network-time-synchronizer.gd"
NetworkRollback="*res://addons/netfox/rollback/network-rollback.gd"
NetworkEvents="*res://addons/netfox/network-events.gd"
NetworkPerformance="*res://addons/netfox/network-performance.gd"
NetworkCommandServer="*res://addons/netfox/servers/network-command-server.gd"
NetworkManager="*uid://4nfm7km0c3lb"
Ollama="*uid://dqmjqyg5t1lsb"
control="*uid://dvqs7px0tmp1o"
options="*uid://cc0p1cwi714l0"
AchievementManager="*uid://dj1bkxbqna8jt"
t="*uid://cua1w6u3nccq5"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/_Godot-IDE_/plugin.cfg", "res://addons/assetplus/plugin.cfg", "res://addons/font_auto_size_labels/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/indent_guidelines/plugin.cfg", "res://addons/milestone/plugin.cfg", "res://addons/netfox.extras/plugin.cfg", "res://addons/netfox.internals/plugin.cfg", "res://addons/netfox/plugin.cfg", "res://addons/virtual_joystick_plus/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/_Godot-IDE_/plugins": "blue",
"res://addons/_Godot-IDE_/plugins/": "blue",
"res://addons/_Godot-IDE_/shared_resources/": "teal"
}

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

