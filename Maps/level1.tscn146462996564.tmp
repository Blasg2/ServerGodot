[sub_resource type="GDScript" id="GDScript_l4ket"]
resource_name = "news"
script/source = "extends Node

@export var http_request_path: NodePath
@export var max_items: int = 5

const REFRESH_SECONDS := 5 * 60 * 60
const GOOGLE_NEWS_RSS_BH := \"https://news.google.com/rss/search?q=%22Belo%20Horizonte%22&hl=pt-BR&gl=BR&ceid=BR:pt-419\"

var _req: HTTPRequest
var _timer_refresh: Timer

const STOPWORDS_PT := {
	\"de\": true, \"da\": true, \"do\": true, \"das\": true, \"dos\": true,
	\"em\": true, \"no\": true, \"na\": true, \"nos\": true, \"nas\": true,
	\"um\": true, \"uma\": true, \"uns\": true, \"umas\": true,
	\"e\": true, \"ou\": true, \"com\": true, \"sem\": true,
	\"por\": true, \"para\": true, \"pra\": true,
	\"após\": true, \"apos\": true,
	\"sobre\": true, \"entre\": true,
	\"bh\": true, \"belo\": true, \"horizonte\": true, \"mg\": true, \"minas\": true, \"gerais\": true
}

func _ready() -> void:
	# No retry loop. If multiplayer isn't ready OR we aren't server, do nothing.
	if multiplayer.multiplayer_peer == null or not multiplayer.is_server():
		return

	_req = get_node_or_null(http_request_path) as HTTPRequest
	if _req == null:
		_req = HTTPRequest.new()
		add_child(_req)

	if not _req.request_completed.is_connected(_on_rss_done):
		_req.request_completed.connect(_on_rss_done)

	_timer_refresh = Timer.new()
	_timer_refresh.one_shot = false
	_timer_refresh.wait_time = float(REFRESH_SECONDS)
	_timer_refresh.timeout.connect(_fetch_once)
	add_child(_timer_refresh)

	_fetch_once()
	_timer_refresh.start()


func _fetch_once() -> void:
	# Safety: only run on server
	if multiplayer.multiplayer_peer == null or not multiplayer.is_server():
		return

	var err := _req.request(GOOGLE_NEWS_RSS_BH)
	if err != OK:
		push_error(\"HTTPRequest.request() failed: %s\" % str(err))


func _on_rss_done(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray) -> void:
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		push_error(\"RSS fetch failed. result=%s code=%s\" % [str(result), str(response_code)])
		return

	var xml_text := body.get_string_from_utf8()
	$ViewPortNews/newsBh.text = _rss_to_ui_lines_dedup(xml_text, max_items)
	$\"../Chelala\".talk($ViewPortNews/newsBh.text)

# \"DD/MM - Headline (Source)\"
func _rss_to_ui_lines_dedup(xml_text: String, max_items_local: int) -> String:
	var p := XMLParser.new()
	var err := p.open_buffer(xml_text.to_utf8_buffer())
	if err != OK:
		return \"XML parse open_buffer error: %s\" % str(err)

	var in_item := false
	var current_tag := \"\"

	var cur_title := \"\"
	var cur_pubdate := \"\"

	var lines: Array[String] = []
	var accepted_word_sets: Array[Dictionary] = [] # each is {word:true}

	while true:
		var r := p.read()
		if r == ERR_FILE_EOF:
			break
		if r != OK:
			return \"XML parse error: %s\" % str(r)

		var t := p.get_node_type()

		if t == XMLParser.NODE_ELEMENT:
			current_tag = p.get_node_name()
			if current_tag == \"item\":
				in_item = true
				cur_title = \"\"
				cur_pubdate = \"\"

		elif t == XMLParser.NODE_TEXT or t == XMLParser.NODE_CDATA:
			if not in_item:
				continue

			var text := p.get_node_data().strip_edges()
			if text.is_empty():
				continue

			match current_tag:
				\"title\":
					cur_title = text
				\"pubDate\":
					cur_pubdate = text

		elif t == XMLParser.NODE_ELEMENT_END:
			var end_name := p.get_node_name()

			if end_name == \"item\":
				in_item = false

				if cur_title != \"\":
					var parsed := _split_headline_source(cur_title)
					var headline = parsed[\"headline\"]
					var source = parsed[\"source\"]
					var day_month := _pubdate_to_day_month_sp(cur_pubdate)

					var ws := _headline_word_set(headline)
					if not _is_too_similar(ws, accepted_word_sets, 0.70):
						accepted_word_sets.append(ws)
						lines.append(\"%s - %s (%s)\" % [day_month, headline, source])

				if lines.size() >= max_items_local:
					break

			if end_name == current_tag:
				current_tag = \"\"

	return \"\\n\".join(lines)


func _split_headline_source(title: String) -> Dictionary:
	var idx := title.rfind(\" - \")
	if idx == -1:
		return {\"headline\": title.strip_edges(), \"source\": \"Unknown\"}

	var headline := title.substr(0, idx).strip_edges()
	var source := title.substr(idx + 3, title.length() - (idx + 3)).strip_edges()
	if source == \"\":
		source = \"Unknown\"
	return {\"headline\": headline, \"source\": source}


func _is_too_similar(ws: Dictionary, accepted: Array[Dictionary], threshold: float) -> bool:
	for prev in accepted:
		if _jaccard(ws, prev) >= threshold:
			return true
	return false


func _jaccard(a: Dictionary, b: Dictionary) -> float:
	var inter := 0
	var uni := 0

	for k in a.keys():
		uni += 1
		if b.has(k):
			inter += 1
	for k in b.keys():
		if not a.has(k):
			uni += 1

	if uni == 0:
		return 0.0
	return float(inter) / float(uni)


func _headline_word_set(headline: String) -> Dictionary:
	var s := _normalize_text(headline)
	var parts := s.split(\" \", false)
	var ws := {}

	for w in parts:
		if w.length() < 3:
			continue
		if STOPWORDS_PT.has(w):
			continue
		ws[w] = true

	return ws


func _normalize_text(s: String) -> String:
	var x := s.to_lower()
	var punct := [\"-\", \"–\", \"—\", \":\", \";\", \",\", \".\", \"!\", \"?\", \"(\", \")\", \"[\", \"]\", \"{\", \"}\", \"\\\"\", \"'\", \"“\", \"”\", \"…\", \"/\"]
	for p in punct:
		x = x.replace(p, \" \")

	while x.find(\"  \") != -1:
		x = x.replace(\"  \", \" \")

	return x.strip_edges()


func _pubdate_to_day_month_sp(pubdate_rfc822: String) -> String:
	var s := pubdate_rfc822.replace(\",\", \"\").strip_edges()
	var parts := s.split(\" \", false)
	if parts.size() < 6:
		return \"??/??\"

	var day := int(parts[1])
	var month := _month_str_to_int(parts[2])
	var year := int(parts[3])

	var hms := parts[4].split(\":\")
	if hms.size() < 2:
		return \"??/??\"

	var hour := int(hms[0])
	var minute := int(hms[1])

	var second := 0
	if hms.size() >= 3:
		second = int(hms[2])

	if month <= 0:
		return \"??/??\"

	var dt_utc := {\"year\": year, \"month\": month, \"day\": day, \"hour\": hour, \"minute\": minute, \"second\": second}
	var unix_utc := int(Time.get_unix_time_from_datetime_dict(dt_utc))
	if unix_utc <= 0:
		return \"??/??\"

	var unix_sp := unix_utc - (3 * 3600)
	var d := Time.get_datetime_dict_from_unix_time(unix_sp)
	return \"%02d/%02d\" % [d.day, d.month]


func _month_str_to_int(m: String) -> int:
	match m:
		\"Jan\": return 1
		\"Feb\": return 2
		\"Mar\": return 3
		\"Apr\": return 4
		\"May\": return 5
		\"Jun\": return 6
		\"Jul\": return 7
		\"Aug\": return 8
		\"Sep\": return 9
		\"Oct\": return 10
		\"Nov\": return 11
		\"Dec\": return 12
	return -1
"

