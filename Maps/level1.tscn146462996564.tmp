[sub_resource type="GDScript" id="GDScript_hk8xa"]
resource_name = "sun"
script/source = "extends DirectionalLight3D

@export var lat := -19.9167
@export var lon := -43.9345
@export var utc_offset_hours := -3.0

@export var sun_energy_day := 1.0
@export var sun_energy_night := 0.0

func _ready() -> void:
	var timer := Timer.new()
	timer.wait_time = 1.0
	timer.autostart = true
	timer.timeout.connect(_update_sun)
	add_child(timer)
	_update_sun()

func _update_sun() -> void:
	var dt := Time.get_datetime_dict_from_system()
	var az_el := _compute_sun_position(dt)
	var az_deg: float = az_el[0]
	var el_deg: float = az_el[1]

	var energy_t := 0.0
	if el_deg <= -1.0:
		energy_t = 0.0
	elif el_deg >= 10.0:
		energy_t = 1.0
	else:
		energy_t = clamp((el_deg + 1.0) / 11.0, 0.0, 1.0)

	light_energy = lerp(sun_energy_night, sun_energy_day, energy_t)

	if energy_t <= 0.001:
		return

	_apply_az_el(az_deg, el_deg)

func _compute_sun_position(dt: Dictionary) -> Array:
	# Julian date calculation
	var y := int(dt.year)
	var m := int(dt.month)
	var d := int(dt.day)
	var hour_utc: float = int(dt.hour) + int(dt.minute) / 60.0 + int(dt.second) / 3600.0 - utc_offset_hours

	if m <= 2:
		y -= 1
		m += 12

	var A = floor(y / 100.0)
	var B = 2.0 - A + floor(A / 4.0)
	var jd: float = floor(365.25 * (y + 4716)) + floor(30.6001 * (m + 1)) + d + B - 1524.5
	jd += hour_utc / 24.0

	# Julian centuries from J2000.0
	var T: float = (jd - 2451545.0) / 36525.0

	# Solar coordinates (simplified but accurate to ~0.01°)
	# Mean longitude
	var L0: float = fposmod(280.46646 + 36000.76983 * T + 0.0003032 * T * T, 360.0)
	# Mean anomaly
	var M_deg: float = fposmod(357.52911 + 35999.05029 * T - 0.0001537 * T * T, 360.0)
	var M: float = deg_to_rad(M_deg)

	# Equation of center
	var C: float = (1.9146 - 0.004817 * T - 0.000014 * T * T) * sin(M)
	C += (0.019993 - 0.000101 * T) * sin(2.0 * M)
	C += 0.00029 * sin(3.0 * M)

	# Sun's true longitude and true anomaly
	var sun_lon: float = L0 + C

	# Obliquity of ecliptic
	var obliq: float = 23.439291 - 0.0130042 * T

	# Right ascension and declination
	var sun_lon_rad: float = deg_to_rad(sun_lon)
	var obliq_rad: float = deg_to_rad(obliq)

	var ra_rad: float = atan2(cos(obliq_rad) * sin(sun_lon_rad), cos(sun_lon_rad))
	var dec_rad: float = asin(sin(obliq_rad) * sin(sun_lon_rad))

	# Greenwich Mean Sidereal Time
	var D0: float = jd - 2451545.0
	var gmst: float = fposmod(280.46061837 + 360.98564736629 * D0, 360.0)

	# Local hour angle
	var lha_deg: float = fposmod(gmst + lon - rad_to_deg(ra_rad), 360.0)
	var lha: float = deg_to_rad(lha_deg)

	# Observer latitude
	var lat_rad: float = deg_to_rad(lat)

	# Elevation (altitude)
	var sin_el: float = sin(lat_rad) * sin(dec_rad) + cos(lat_rad) * cos(dec_rad) * cos(lha)
	var el_deg: float = rad_to_deg(asin(clamp(sin_el, -1.0, 1.0)))

	# Azimuth (measured from North, clockwise)
	var cos_az: float = (sin(dec_rad) - sin(el_deg * PI / 180.0) * sin(lat_rad)) / (cos(el_deg * PI / 180.0) * cos(lat_rad))
	cos_az = clamp(cos_az, -1.0, 1.0)
	var az_deg: float = rad_to_deg(acos(cos_az))

	# Azimuth is east in morning, west in afternoon
	if sin(lha) > 0.0:
		az_deg = 360.0 - az_deg

	return [az_deg, el_deg]

func _apply_az_el(az_deg: float, el_deg: float) -> void:
	var az := deg_to_rad(az_deg)
	var el := deg_to_rad(el_deg)

	var sun_pos_dir := Vector3(
		sin(az) * cos(el),
		sin(el),
		-cos(az) * cos(el)
	).normalized()

	var rays_dir := -sun_pos_dir
	look_at(global_position + rays_dir, Vector3.UP)
"

