[gd_scene format=3 uid="uid://yi5edt278ikl"]

[sub_resource type="GDScript" id="GDScript_icnox"]
resource_name = "falar"
script/source = "extends Label3D
var markerPath: NodePath
var chateando := false
var marker: Node
@onready var MarkerOrigin := $\"../MarkerOrigin\"

func _ready() -> void:
	marker = get_node_or_null(markerPath)
	MarkerOrigin.global_position = marker.global_position
	MarkerOrigin.global_rotation = marker.global_rotation
	global_position = marker.global_position
	chateando = true
	await get_tree().create_timer(2).timeout
	chateando = false
	await get_tree().create_timer(3.5).timeout
	$\"..\".queue_free()

func _physics_process(delta: float) -> void:
	if chateando and is_instance_valid(self):
		global_position += -MarkerOrigin.global_transform.basis.z * 1 * delta
	
"

[node name="Node3D" type="Node3D" unique_id=1166573781]

