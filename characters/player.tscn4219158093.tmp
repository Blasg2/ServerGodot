[sub_resource type="GDScript" id="GDScript_x1lbd"]
resource_name = "testes"
script/source = "extends Node3D




func _process(delta: float) -> void:
	if $\"../Input\".get_multiplayer_authority() == multiplayer.get_unique_id():
		if Input.is_action_just_pressed(\"ui_page_down\"): 
			
			get_node(\"/root/World/Players\").rpc_id(1, \"change_level\", \"level1\", Vector3(1,1,1))
		if Input.is_action_just_pressed(\"ui_page_up\"):
			get_node(\"/root/World/Players\").rpc_id(1, \"change_level\", \"Casa\", Vector3(0,15.1,0))
"

