[sub_resource type="GDScript" id="GDScript_evndh"]
resource_name = "camera_pivot"
script/source = "extends Node3D
@export var mouse_sensibility := 0.005
@export_range(-90.0, 0.0, 0.1, \"radians_as_degrees\") var min_vertical_angle: float = -PI/2
@export_range(0.0, 90.0, 0.1, \"radians_as_degrees\") var max_vertical_angle: float = PI/4
@onready var spring_arm := $SpringArm3D
@export var joy_sensitivity := 3.0
var joy_look: Vector2 = Vector2.ZERO
var _touches: Dictionary = {}

func _ready() -> void:
	control.joystick.connect(setJoy)

func _input(event: InputEvent) -> void:
	if $\"../Input\".is_multiplayer_authority():
		if event is InputEventMouseMotion and not OS.has_feature(\"mobile\"):
			rotation.y -= event.relative.x * mouse_sensibility
			rotation.y = wrapf(rotation.y, 0.0, TAU)
			rotation.x -= event.relative.y * mouse_sensibility
			rotation.x = clamp(rotation.x, min_vertical_angle, max_vertical_angle)
		
		if event.is_action_pressed(\"wheel_up\"):
			_zoom(-1)
		if event.is_action_pressed(\"wheel_down\"):
			_zoom(1)
		
		# Pinch to zoom
		if event is InputEventScreenTouch:
			if event.pressed:
				_touches[event.index] = event.position
			else:
				_touches.erase(event.index)
		
		if event is InputEventScreenDrag and _touches.size() == 2:
			var old_pos = _touches[event.index]
			_touches[event.index] = event.position
			var keys = _touches.keys()
			var other_key = keys[0] if event.index == keys[1] else keys[1]
			var old_dist = old_pos.distance_to(_touches[other_key])
			var new_dist = _touches[keys[0]].distance_to(_touches[keys[1]])
			var diff = new_dist - old_dist
			if abs(diff) > 2.0:
				_zoom(-sign(diff))

func _process(delta: float) -> void:
	if joy_look.length() > 0.1:
		rotation.y -= joy_look.x * joy_sensitivity * delta
		rotation.y = wrapf(rotation.y, 0.0, TAU)
		rotation.x -= joy_look.y * joy_sensitivity * delta
		rotation.x = clamp(rotation.x, min_vertical_angle, max_vertical_angle)

func _zoom(dir: float) -> void:
	spring_arm.spring_length = clamp(spring_arm.spring_length + dir )

func setJoy(a, b) -> void:
	b.analogic_changed.connect(_on_right_joy_analogic_changed)

func _on_right_joy_analogic_changed(value: Vector2, _distance: float, _angle: float, _angle_clockwise: float, _angle_not_clockwise: float) -> void:
	joy_look = value
"

[sub_resource type="SphereShape3D" id="SphereShape3D_evndh"]
