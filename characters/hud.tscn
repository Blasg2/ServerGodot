[sub_resource type="GDScript" id="GDScript_f41vb"]
resource_name = "falarReal"
script/source = "extends LineEdit

func _on_text_submitted(texto: String) -> void:
	var markerP = $\"..\".get_parent().get_node(\"Mesh/meshy/Chat\")
	get_node(\"/root/World/Chat\").spawn_message.rpc(texto, str(markerP.get_path()))
	text = \"\"
	edit.call_deferred()
"

[sub_resource type="CircleShape2D" id="CircleShape2D_6nikj"]
radius = 329.47

[sub_resource type="GDScript" id="GDScript_3yxbx"]
script/source = "extends Node

func _ready():
	##Gráfico button set
	if options.render_scale == 0.4: $Phone/OptionButton.selected = 0
	elif options.render_scale == 0.7: $Phone/OptionButton.selected = 1

	##FPS BUTTON SET
	if options.max_fps == 30: 
		$\"Phone/30fps\".button_pressed = true


func _on_phone_button_pressed():
	$Phone.visible = not $Phone.visible

##Gráfico
func _on_option_button_item_selected(index: int) -> void:
	if index == 0:
		options.render_scale = 0.4
	elif index == 1:
		options.render_scale = 0.7
	elif index == 2:
		options.render_scale = 1.0
	options._apply()	

##FPS
func _on_fps_toggled(toggled_on: bool) -> void:
	if toggled_on:
		options.max_fps = 30
	else:
		options.max_fps = 60
	options._apply()
"

[sub_resource type="ViewportTexture" id="ViewportTexture_mrv8i"]

[sub_resource type="GDScript" id="GDScript_egd0o"]
resource_name = "ping"
script/source = "extends Label

func _process(_delta):
	if multiplayer.get_unique_id() == 1:
		return
	var peer = multiplayer.multiplayer_peer
	if peer == null:
		return
	var peer_info = peer.get_peer(1)
	if peer_info == null:
		return
	var rtt = peer_info.get_statistic(ENetPacketPeer.PEER_ROUND_TRIP_TIME)
	var loss_raw = peer_info.get_statistic(ENetPacketPeer.PEER_PACKET_LOSS)
	var loss_pct = loss_raw / 655.36
	text = \"Ping: %d ms | Loss: %.1f%% | FPS: %d\" % [rtt, loss_pct, Engine.get_frames_per_second()]  #NOTE: + \" | Tick: %d\" % [NetworkTime.tick]
"

